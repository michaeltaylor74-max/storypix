<?xml version="1.0" encoding="utf-8"?>
<!-- Microsoft Store package for StoryPix. The identity values come from Partner Center
     (Product management → Product identity). __VERSION__ is filled in by the build. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="TaylorMadeApps.StoryPix"
    Publisher="CN=624CA1A7-609A-4CAB-91A9-536361786480"
    Version="__VERSION__"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>StoryPix</DisplayName>
    <PublisherDisplayName>Taylor Made Apps</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Turn folders of photos and videos into a slideshow video with music.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="en-gb" />
    <Resource Language="en-au" />
  </Resources>

  <Applications>
    <Application Id="StoryPix" Executable="StoryPix.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="StoryPix"
        Description="Turn folders of photos and videos into a slideshow video with music."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" ShortName="StoryPix" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
