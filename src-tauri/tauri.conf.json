{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhotoStory",
  "version": "0.1.0",
  "identifier": "com.michaeltaylor.photostory",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PhotoStory",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "maximized": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "shortDescription": "Photo & video slideshow maker",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
